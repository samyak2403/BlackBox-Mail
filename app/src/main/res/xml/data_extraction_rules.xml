<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for API 31+.

   SessionStore keeps the mail.tm mailbox passwords and the cached bearer token in the
   "blackbox_mail_session" SharedPreferences file. Those are live credentials for a
   disposable mailbox, so they are excluded from both cloud backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="blackbox_mail_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="blackbox_mail_session.xml" />
    </device-transfer>
</data-extraction-rules>
