<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices older than API 31 (see data_extraction_rules.xml for API 31+).

   SessionStore keeps the mail.tm mailbox passwords and the cached bearer token in the
   "blackbox_mail_session" SharedPreferences file. Those are live credentials, so they must
   never leave the device through Android's automatic backup.
-->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="blackbox_mail_session.xml" />
</full-backup-content>
